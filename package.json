{
  "name": "@jeswr/solid-specs-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "The @jeswr Solid specifications monorepo",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright <63333554+jeswr@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-specs.git"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:structure": "node scripts/check-structure.mjs",
    "check:packages": "node guardrails/scripts/check-packages.mjs --ecosystem npm",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node --test \"scripts/*.test.mjs\" && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "gate": "pnpm run check:structure && pnpm run test && pnpm run lint && pnpm run typecheck && pnpm run build"
  }
}
