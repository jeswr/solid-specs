{
  "profile": "https://jeswr.org/ns/solid-sd#y-protocol-v1",
  "yjs": "13.6.31",
  "cases": [
    {
      "id": "header-update-hi",
      "description": "JYU1 inserting hi: header 4A 59 55 31 00 00 00 00 00 00 03 E8 01 02 03 04; time 1000 ms, nonce 0x01020304; v1 payload follows at byte 16.",
      "statements": [
        "enc-layout",
        "enc-time",
        "enc-valid"
      ],
      "resources": [
        {
          "name": "server-chosen-name",
          "hex": "4a59553100000000000003e80102030401010a000401047465787402686900"
        }
      ],
      "expect": {
        "kind": "update",
        "time": 1000,
        "nonce": 16909060
      }
    },
    {
      "id": "single-update-hi",
      "description": "One valid JYU1 resource with a server-chosen name inserts hi.",
      "statements": [
        "enc-layout",
        "enc-valid",
        "enc-media-type-ignore",
        "load-all"
      ],
      "resources": [
        {
          "name": "server-chosen-name",
          "hex": "4a59553100000000000003e80102030401010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": "hi"
        },
        "valid": [
          "server-chosen-name"
        ],
        "invalid": []
      }
    },
    {
      "id": "header-snapshot",
      "description": "JYS1: header 4A 59 53 31 00 00 00 00 00 00 07 D0 05 06 07 08; a full-state Yjs v1 update is the snapshot payload.",
      "statements": [
        "enc-layout",
        "enc-valid"
      ],
      "resources": [
        {
          "name": "snapshot",
          "hex": "4a59533100000000000007d00506070801010a000401047465787402686900"
        }
      ],
      "expect": {
        "kind": "snapshot",
        "time": 2000,
        "nonce": 84281096
      }
    },
    {
      "id": "single-snapshot",
      "description": "A JYS1 snapshot alone restores hi.",
      "statements": [
        "enc-valid",
        "load-all"
      ],
      "resources": [
        {
          "name": "snapshot",
          "hex": "4a59533100000000000007d00506070801010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": "hi"
        },
        "valid": [
          "snapshot"
        ],
        "invalid": []
      }
    },
    {
      "id": "offline-older-than-snapshot",
      "description": "Snapshot S at time 2000 contains A and B; offline update C at time 1000 is absent from S. C depends on A and must survive even when read before S. Filtering by snapshot time loses C.",
      "statements": [
        "enc-valid",
        "load-all",
        "load-order"
      ],
      "resources": [
        {
          "name": "snapshot-ab",
          "hex": "4a59533100000000000007d00000001402010200840100014201010004010474657874014100"
        },
        {
          "name": "offline-c",
          "hex": "4a59553100000000000003e80000000a01010300840100014300"
        }
      ],
      "expect": {
        "text": {
          "text": "ABC"
        },
        "valid": [
          "snapshot-ab",
          "offline-c"
        ],
        "invalid": []
      }
    },
    {
      "id": "concurrent-snapshots",
      "description": "Concurrent snapshots contain A+B and A+C respectively; each lacks the other's insertion. Loading both must retain A+B+C, including the older snapshot's B.",
      "statements": [
        "load-all",
        "load-order"
      ],
      "resources": [
        {
          "name": "snapshot-ac",
          "hex": "4a5953310000000000000bb80000001e02010300840100014301010004010474657874014100"
        },
        {
          "name": "snapshot-ab",
          "hex": "4a59533100000000000007d00000001402010200840100014201010004010474657874014100"
        }
      ],
      "expect": {
        "text": {
          "text": "ABC"
        },
        "valid": [
          "snapshot-ac",
          "snapshot-ab"
        ],
        "invalid": []
      }
    },
    {
      "id": "overlapping-snapshots-and-updates",
      "description": "The two snapshots overlap on A, and the original A and C are also present. Reapplying overlapping content is harmless.",
      "statements": [
        "load-all"
      ],
      "resources": [
        {
          "name": "snapshot-ac",
          "hex": "4a5953310000000000000bb80000001e02010300840100014301010004010474657874014100"
        },
        {
          "name": "offline-c",
          "hex": "4a59553100000000000003e80000000a01010300840100014300"
        },
        {
          "name": "original-a",
          "hex": "4a59553100000000000001f4000000050101010004010474657874014100"
        },
        {
          "name": "snapshot-ab",
          "hex": "4a59533100000000000007d00000001402010200840100014201010004010474657874014100"
        }
      ],
      "expect": {
        "text": {
          "text": "ABC"
        },
        "valid": [
          "snapshot-ac",
          "offline-c",
          "original-a",
          "snapshot-ab"
        ],
        "invalid": []
      }
    },
    {
      "id": "snapshot-with-pending-update",
      "description": "A snapshot made before its compactor sees A must retain C's unintegrated content. A later resource supplies A and makes C visible.",
      "statements": [
        "cmp-snapshot",
        "cmp-pending",
        "load-all"
      ],
      "resources": [
        {
          "name": "pending-snapshot",
          "hex": "4a59533100000000000001f40000002801010300840100014300"
        },
        {
          "name": "dependency-a",
          "hex": "4a5955310000000000000258000000320101010004010474657874014100"
        }
      ],
      "expect": {
        "text": {
          "text": "AC"
        },
        "valid": [
          "pending-snapshot",
          "dependency-a"
        ],
        "invalid": []
      }
    },
    {
      "id": "header-legacy",
      "description": "The exact legacy name supplies time 1761480000000 and nonce 0; the entire headerless body is the v1 update.",
      "statements": [
        "legacy-read"
      ],
      "resources": [
        {
          "name": "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "01010a000401047465787402686900"
        }
      ],
      "expect": {
        "kind": "legacy",
        "time": 1761480000000,
        "nonce": 0
      }
    },
    {
      "id": "legacy-update",
      "description": "A supported headerless legacy resource inserts hi.",
      "statements": [
        "legacy-read",
        "load-all"
      ],
      "resources": [
        {
          "name": "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "01010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": "hi"
        },
        "valid": [
          "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c"
        ],
        "invalid": []
      }
    },
    {
      "id": "short-valid-legacy",
      "description": "A two-byte empty Yjs update is valid under the legacy rule despite being shorter than a record header.",
      "statements": [
        "legacy-read"
      ],
      "resources": [
        {
          "name": "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "0000"
        }
      ],
      "expect": {
        "kind": "legacy",
        "time": 1761480000000,
        "nonce": 0
      }
    },
    {
      "id": "headed-legacy-name",
      "description": "A headed resource takes its kind, time and nonce from its header even when its name matches the legacy pattern.",
      "statements": [
        "enc-valid",
        "enc-media-type-ignore"
      ],
      "resources": [
        {
          "name": "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "4a595331000000000000002a0000000701010a000401047465787402686900"
        }
      ],
      "expect": {
        "kind": "snapshot",
        "time": 42,
        "nonce": 7
      }
    },
    {
      "id": "header-zero-time-max-nonce",
      "description": "Zero is a valid timestamp; FF FF FF FF is unsigned nonce 4294967295.",
      "statements": [
        "enc-time",
        "enc-valid"
      ],
      "resources": [
        {
          "name": "zero-time",
          "hex": "4a5955310000000000000000ffffffff01010a000401047465787402686900"
        }
      ],
      "expect": {
        "kind": "update",
        "time": 0,
        "nonce": 4294967295
      }
    },
    {
      "id": "header-max-safe-time",
      "description": "00 1F FF FF FF FF FF FF is the largest permitted time (2^53 - 1); nonce zero is valid.",
      "statements": [
        "enc-time",
        "enc-valid"
      ],
      "resources": [
        {
          "name": "max-time",
          "hex": "4a595531001fffffffffffff0000000001010a000401047465787402686900"
        }
      ],
      "expect": {
        "kind": "update",
        "time": 9007199254740991,
        "nonce": 0
      }
    },
    {
      "id": "ordering-key-tie-break",
      "description": "All times are 1000. Unsigned nonce 1 precedes 4294967295 regardless of name; equal nonces then compare resource IRIs by code point. Ascending names: m-low-nonce, z-low-nonce, a-high-nonce.",
      "statements": [
        "load-order",
        "load-all"
      ],
      "resources": [
        {
          "name": "a-high-nonce",
          "hex": "4a59553100000000000003e8ffffffff01010300840100014300"
        },
        {
          "name": "z-low-nonce",
          "hex": "4a59553100000000000003e80000000101010200840100014200"
        },
        {
          "name": "m-low-nonce",
          "hex": "4a59553100000000000003e8000000010101010004010474657874014100"
        }
      ],
      "expect": {
        "text": {
          "text": "ABC"
        },
        "valid": [
          "a-high-nonce",
          "z-low-nonce",
          "m-low-nonce"
        ],
        "invalid": []
      }
    },
    {
      "id": "invalid-short-header",
      "description": "A body shorter than 16 bytes (15 bytes of an otherwise valid header).",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic"
      ],
      "resources": [
        {
          "name": "short-header",
          "hex": "4a59553100000000000003e8000000"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "short-header"
        ]
      }
    },
    {
      "id": "invalid-wrong-magic",
      "description": "Wrong magic BAD1, with a non-legacy name, even though the header fields and payload are otherwise valid.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic"
      ],
      "resources": [
        {
          "name": "wrong-magic",
          "hex": "4241443100000000000003e80000000101010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "wrong-magic"
        ]
      }
    },
    {
      "id": "invalid-unsafe-time",
      "description": "A valid magic with time 2^53, one greater than the safe integer limit.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic"
      ],
      "resources": [
        {
          "name": "unsafe-time",
          "hex": "4a59553100200000000000000000000101010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "unsafe-time"
        ]
      }
    },
    {
      "id": "invalid-undecodable-payload",
      "description": "Valid JYU1 header, but the payload has complete insert structs followed by a truncated delete set; unsafe application would partially insert poison.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic"
      ],
      "resources": [
        {
          "name": "undecodable-payload",
          "hex": "4a59553100000000000003e800000001010104000401047465787406706f69736f6e"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "undecodable-payload"
        ]
      }
    },
    {
      "id": "invalid-legacy-undecodable",
      "description": "A legacy name cannot rescue a headerless body whose Yjs decode fails after complete insert structs.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic",
        "legacy-read"
      ],
      "resources": [
        {
          "name": "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "010104000401047465787406706f69736f6e"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c"
        ]
      }
    },
    {
      "id": "invalid-empty-payload",
      "description": "An exactly 16-byte JYS1 header without a Yjs payload cannot decode.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic"
      ],
      "resources": [
        {
          "name": "empty-payload",
          "hex": "4a59533100000000000003e800000001"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "empty-payload"
        ]
      }
    },
    {
      "id": "invalid-headerless-name",
      "description": "A valid headerless Yjs update without the required legacy name is not a log resource.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic",
        "legacy-read"
      ],
      "resources": [
        {
          "name": "unrecognised-headerless-name",
          "hex": "01010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "unrecognised-headerless-name"
        ]
      }
    },
    {
      "id": "invalid-legacy-uppercase",
      "description": "Uppercase hexadecimal in the UUID does not match the case-sensitive legacy name pattern.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic",
        "legacy-read"
      ],
      "resources": [
        {
          "name": "001761480000000-0F8E2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "01010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "001761480000000-0F8E2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c"
        ]
      }
    },
    {
      "id": "invalid-legacy-short-time",
      "description": "A 13-digit time does not match the 15-digit legacy name pattern.",
      "statements": [
        "enc-valid",
        "load-invalid",
        "load-atomic",
        "legacy-read"
      ],
      "resources": [
        {
          "name": "1761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "01010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": ""
        },
        "valid": [],
        "invalid": [
          "1761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c"
        ]
      }
    },
    {
      "id": "reject-invalid-without-partial-application",
      "description": "Load hi alongside all malformed resources. Validate each whole payload before application: none may insert even part of poison, in either ordering direction.",
      "statements": [
        "enc-valid",
        "enc-time",
        "load-all",
        "load-invalid",
        "load-atomic",
        "legacy-read"
      ],
      "resources": [
        {
          "name": "undecodable-payload",
          "hex": "4a59553100000000000003e800000001010104000401047465787406706f69736f6e"
        },
        {
          "name": "server-chosen-name",
          "hex": "4a59553100000000000003e80102030401010a000401047465787402686900"
        },
        {
          "name": "short-header",
          "hex": "4a59553100000000000003e8000000"
        },
        {
          "name": "wrong-magic",
          "hex": "4241443100000000000003e80000000101010a000401047465787402686900"
        },
        {
          "name": "unsafe-time",
          "hex": "4a59553100200000000000000000000101010a000401047465787402686900"
        },
        {
          "name": "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "010104000401047465787406706f69736f6e"
        },
        {
          "name": "empty-payload",
          "hex": "4a59533100000000000003e800000001"
        },
        {
          "name": "unrecognised-headerless-name",
          "hex": "01010a000401047465787402686900"
        },
        {
          "name": "001761480000000-0F8E2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "01010a000401047465787402686900"
        },
        {
          "name": "1761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "hex": "01010a000401047465787402686900"
        }
      ],
      "expect": {
        "text": {
          "text": "hi"
        },
        "valid": [
          "server-chosen-name"
        ],
        "invalid": [
          "short-header",
          "wrong-magic",
          "unsafe-time",
          "undecodable-payload",
          "001761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "empty-payload",
          "unrecognised-headerless-name",
          "001761480000000-0F8E2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c",
          "1761480000000-0f8e2c6a-3b1d-4f5e-9a7c-2d4b6e8f0a1c"
        ]
      }
    }
  ]
}
