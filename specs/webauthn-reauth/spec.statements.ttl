        <#SWRA-CORS-1> , <#SWRA-CORS-2> , <#SWRA-CORS-3> , <#SWRA-CORS-4> , <#SWRA-CORS-5> ,
        <#SWRA-BUNDLE-1> , <#SWRA-BUNDLE-2> , <#SWRA-BUNDLE-3> , <#SWRA-BUNDLE-4> ,
        <#SWRA-BUNDLE-5> , <#SWRA-BUNDLE-6> ,
        <#SWRA-TX-1> , <#SWRA-TX-2> , <#SWRA-TX-3> ,
        <#SWRA-CLIENT-1> , <#SWRA-CLIENT-2> , <#SWRA-CLIENT-3> , <#SWRA-CLIENT-4> ,
        <#SWRA-CLIENT-5> , <#SWRA-CLIENT-6> , <#SWRA-CLIENT-7> , <#SWRA-CLIENT-8> ,
