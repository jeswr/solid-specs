        <#SWRA-TERM-1> ,
        <#SWRA-ORIGIN-1> , <#SWRA-ORIGIN-2> , <#SWRA-ORIGIN-3> , <#SWRA-ORIGIN-4> ,
        <#SWRA-ORIGIN-5> , <#SWRA-ORIGIN-6> , <#SWRA-ORIGIN-7> , <#SWRA-ORIGIN-8> ,
        <#SWRA-REG-1> , <#SWRA-REG-2> , <#SWRA-REG-3> , <#SWRA-REG-4> , <#SWRA-REG-5> ,
