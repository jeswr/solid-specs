# AUTHORED-BY Claude Opus 5.5
# EXPECT: SSD-DM-12
# Patch support whose media types are not type/subtype.
@prefix pim: <http://www.w3.org/ns/pim/space#> . @prefix lws: <https://www.w3.org/ns/lws#> . @prefix did: <https://www.w3.org/ns/did#> . @prefix notify: <http://www.w3.org/ns/solid/notifications#> . @prefix dct: <http://purl.org/dc/terms/> . @prefix xsd: <http://www.w3.org/2001/XMLSchema#> . @prefix ssd: <https://jeswr.org/ns/solid-sd#> .
<https://pod.example/> a pim:Storage ; did:service [ a lws:StorageRoot ; did:serviceEndpoint <https://pod.example/> ] ; lws:capability [ a ssd:PatchSupport ; ssd:source "invalid" ; ssd:patchType "text/n3" ] .
